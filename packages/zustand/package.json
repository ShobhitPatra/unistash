{
  "name": "@unistash/zustand",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "[DEPRECATED] Use the `unistash` package instead. Zustand adapter for Unistash v1.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "unistash",
    "zustand",
    "state-management",
    "react",
    "adapter"
  ],
  "author": "ShobhitPatra<shobhitpatra.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShobhitPatra/unistash",
    "directory": "packages/zustand"
  },
  "homepage": "https://unistash-seven.vercel.app/docs/adapter/zustand",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zustand": "^4.0.0"
  },
  "dependencies": {
    "@unistash/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@unistash/tsconfig": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.0.0",
    "zustand": "^4.0.0"
  },
  "files": [
    "dist"
  ]
}
